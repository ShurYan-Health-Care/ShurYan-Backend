{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Information",
            "Microsoft.EntityFrameworkCore.Database.Command": "Information",
            "Microsoft.EntityFrameworkCore": "Information"
        }
    },

    "GeminiAI": {
        "ApiKey": "YOUR_GEMINI_API_KEY",
        "ModelName": "gemini-2.5-flash"
    },
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost;Database=ShuryanDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
    },
    "JwtSettings": {
        "SecretKey": "YOUR_DEVELOPMENT_JWT_SECRET_KEY_MINIMUM_32_BYTES_LONG",
        "Issuer": "Shuryan",
        "Audience": "ShuryanAPI",
        "AccessTokenExpirationMinutes": 60,
        "RefreshTokenExpirationDays": 7,
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkewMinutes": 0
    },

    "Paymob": {
        "APIKey": "YOUR_PAYMOB_API_KEY",
        "PublicKey": "YOUR_PAYMOB_PUBLIC_KEY",
        "SecretKey": "YOUR_PAYMOB_SECRET_KEY",
        "HMAC": "YOUR_PAYMOB_HMAC_SECRET",
        "CardIntegrationId": "YOUR_PAYMOB_CARD_INTEGRATION_ID",
        "MobileIntegrationId": "YOUR_PAYMOB_MOBILE_INTEGRATION_ID",
        "CardIFrameId": "YOUR_PAYMOB_CARD_IFRAME_ID",
        "MobileIFrameId": "YOUR_PAYMOB_MOBILE_IFRAME_ID",
        "BaseUrl": "https://accept.paymob.com/api",
        "TimeoutSeconds": 30
    },
    "FrontendSettings": {
        "BaseUrl": "http://localhost:5173",
        "PaymentSuccessUrl": "/patient/payment/success",
        "PaymentFailedUrl": "/patient/payment/failed"
    },
    "EmailSettings": {
        "SmtpHost": "smtp.gmail.com",
        "SmtpPort": 587,
        "EnableSsl": true,
        "SmtpUsername": "your-email@gmail.com",
        "SmtpPassword": "YOUR_GMAIL_APP_PASSWORD",
        "FromName": "Shuryan Healthcare",
        "FromEmail": "noreply@shuryan.com",
        "VerificationTokenExpirationHours": 24,
        "PasswordResetTokenExpirationHours": 1,
        "ApplicationBaseUrl": "https://localhost:7000"
    },

    "OAuthSettings": {
        "Google": {
            "Enabled": true,
            "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
            "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
        }
    },
    "AgoraSettings": {
        "AppId": "YOUR_AGORA_APP_ID",
        "AppCertificate": "YOUR_AGORA_APP_CERTIFICATE",
        "TokenExpirySeconds": 3600
    },
    
    "CloudinarySettings": {
        "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
        "ApiKey": "YOUR_CLOUDINARY_API_KEY",
        "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
    },

    "DevSettings": {
        "EnableSwagger": true,
        "EnableDetailedErrors": true,
        "SeedTestData": true,
        "MockExternalServices": true 
    }
}
